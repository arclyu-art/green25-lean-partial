import Green25.Averaging
import Mathlib.Data.Fintype.EquivFin
import Mathlib.GroupTheory.Coset.Card
import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# Binary code images and coset colorings

This file connects the Boolean matrix construction to natural-number XOR and finite additive
quotients.  It is the bridge from the averaging certificate to an actual coloring.
-/

namespace Green25

/-- `Nat.ofBits` recovers a number known to fit in its lowest `d` bits. -/
theorem ofBits_natBits {d a : ℕ} (ha : a < 2 ^ d) : Nat.ofBits (natBits d a) = a := by
  change Nat.ofBits (fun i : Fin d ↦ a.testBit i.val) = a
  rw [Nat.ofBits_testBit, Nat.mod_eq_of_lt ha]

/-- Encoding a Boolean vector and reading its lowest `d` bits returns the original vector. -/
theorem natBits_ofBits {d : ℕ} (x : BVec d) : natBits d (Nat.ofBits x) = x := by
  funext i
  simp [natBits, i.isLt]

/-- The finite bit encoding is injective. -/
theorem ofBits_injective {d : ℕ} : Function.Injective (@Nat.ofBits d) := by
  intro x y hxy
  rw [← natBits_ofBits x, ← natBits_ofBits y, hxy]

/-- `Nat.ofBits` converts pointwise Boolean addition into natural-number XOR. -/
theorem ofBits_add {d : ℕ} (x y : BVec d) :
    Nat.ofBits (x + y) = Nat.ofBits x ^^^ Nat.ofBits y := by
  apply Nat.eq_of_testBit_eq
  intro i
  rw [Nat.testBit_xor, Nat.testBit_ofBits, Nat.testBit_ofBits, Nat.testBit_ofBits]
  split <;> simp_all [Bool.add_eq_xor]

/-- Hamming weight is unchanged by finite bit encoding. -/
theorem natBitWeight_ofBits {d : ℕ} (x : BVec d) :
    natBitWeight d (Nat.ofBits x) = boolWeight x := by
  unfold natBitWeight boolWeight
  congr 2
  ext i
  simp [i.isLt]

/-- Boolean dot product is additive in its first argument. -/
theorem boolDot_add_left {m : ℕ} (x y v : BVec m) :
    boolDot (x + y) v = boolDot x v + boolDot y v := by
  unfold boolDot
  simp_rw [Pi.add_apply, add_mul]
  exact Finset.sum_add_distrib

/-- Boolean dot product is additive in its second argument. -/
theorem boolDot_add_right {m : ℕ} (x v w : BVec m) :
    boolDot x (v + w) = boolDot x v + boolDot x w := by
  unfold boolDot
  simp_rw [Pi.add_apply, mul_add]
  exact Finset.sum_add_distrib

/-- The matrix action as an additive homomorphism. -/
def matrixAddHom {m d : ℕ} (T : BMatrix m d) : BVec m →+ BVec d where
  toFun := applyMatrix T
  map_zero' := by
    funext j
    simp [applyMatrix, boolDot]
  map_add' x y := by
    funext j
    simpa [applyMatrix] using boolDot_add_right (T j) x y

/-- The image code generated by the columns of `T`. -/
def codeSubgroup {m d : ℕ} (T : BMatrix m d) : AddSubgroup (BVec d) :=
  (matrixAddHom T).range

/-- Natural-number encoding of all codewords in the image of `T`. -/
def codeNatFinset {m d : ℕ} (T : BMatrix m d) : Finset ℕ :=
  (Finset.univ : Finset (BVec m)).image fun v ↦ Nat.ofBits (applyMatrix T v)

@[simp] theorem ofBits_applyMatrix_zero {m d : ℕ} (T : BMatrix m d) :
    Nat.ofBits (applyMatrix T (0 : BVec m)) = 0 := by
  have hzero : applyMatrix T (0 : BVec m) = 0 := by
    funext j
    simp [applyMatrix, boolDot]
  rw [hzero]
  rw [← show natBits d 0 = (0 : BVec d) by
    funext i
    simp [natBits, Bool.zero_eq_false]]
  exact ofBits_natBits (pow_pos (by decide) _)

/-- Under injectivity, deleting zero after encoding the image is the same as deleting it before. -/
theorem erase_codeNatFinset_eq_image_erase {m d : ℕ} (T : BMatrix m d)
    (hT : Function.Injective (applyMatrix T)) :
    (codeNatFinset T).erase 0 =
      ((Finset.univ : Finset (BVec m)).erase 0).image
        (fun v ↦ Nat.ofBits (applyMatrix T v)) := by
  classical
  ext h
  constructor
  · intro hh
    have hh0 : h ≠ 0 := (Finset.mem_erase.mp hh).1
    obtain ⟨v, _hv, rfl⟩ := Finset.mem_image.mp (Finset.mem_erase.mp hh).2
    apply Finset.mem_image.mpr
    refine ⟨v, Finset.mem_erase.mpr ⟨?_, Finset.mem_univ _⟩, rfl⟩
    intro hv0
    subst v
    exact hh0 (ofBits_applyMatrix_zero T)
  · intro hh
    obtain ⟨v, hv, rfl⟩ := Finset.mem_image.mp hh
    have hv0 : v ≠ 0 := (Finset.mem_erase.mp hv).1
    apply Finset.mem_erase.mpr
    refine ⟨?_, Finset.mem_image.mpr ⟨v, Finset.mem_univ _, rfl⟩⟩
    intro hzero
    have himage : applyMatrix T v = applyMatrix T 0 := by
      apply ofBits_injective
      simpa using hzero
    exact hv0 (hT himage)

/-- The natural-number code weight sum is exactly the matrix score. -/
theorem codeNatFinset_weight_sum_eq_matrixScore {m d : ℕ} (T : BMatrix m d)
    (hT : Function.Injective (applyMatrix T)) :
    (∑ h ∈ (codeNatFinset T).erase 0, 2 ^ (d - natBitWeight d h)) = matrixScore T := by
  classical
  rw [erase_codeNatFinset_eq_image_erase T hT]
  rw [Finset.sum_image]
  · simp [matrixScore, vectorScore, natBitWeight_ofBits]
  · intro v _hv w _hw hvw
    exact hT (ofBits_injective hvw)

noncomputable local instance codeQuotientFintype {m d : ℕ} {T : BMatrix m d} :
    Fintype (BVec d ⧸ codeSubgroup T) :=
  Fintype.ofFinite _

/-- A canonical finite label for each additive coset of the image code. -/
noncomputable def quotientColor {m d : ℕ} (T : BMatrix m d) :
    BVec d → Fin (Fintype.card (BVec d ⧸ codeSubgroup T)) :=
  fun x ↦ Fintype.equivFin (BVec d ⧸ codeSubgroup T) (x : BVec d ⧸ codeSubgroup T)

/-- Equal quotient labels differ by a codeword. -/
theorem add_mem_codeSubgroup_of_quotientColor_eq {m d : ℕ} (T : BMatrix m d)
    {x y : BVec d} (hxy : quotientColor T x = quotientColor T y) :
    x + y ∈ codeSubgroup T := by
  have hquot : (x : BVec d ⧸ codeSubgroup T) = (y : BVec d ⧸ codeSubgroup T) :=
    (Fintype.equivFin (BVec d ⧸ codeSubgroup T)).injective hxy
  have hsub : x - y ∈ codeSubgroup T := QuotientAddGroup.eq_iff_sub_mem.mp hquot
  have hneg : -y = y := by
    funext i
    exact Bool.neg_eq_id (y i)
  rwa [sub_eq_add_neg, hneg] at hsub

/-- Equal quotient labels have natural-number XOR displacement in the encoded code. -/
theorem xor_mem_codeNatFinset_of_quotientColor_eq {m d : ℕ} (T : BMatrix m d)
    {x y : BVec d} (hxy : quotientColor T x = quotientColor T y) :
    Nat.ofBits x ^^^ Nat.ofBits y ∈ codeNatFinset T := by
  have hmem := add_mem_codeSubgroup_of_quotientColor_eq T hxy
  obtain ⟨v, hv⟩ := hmem
  rw [← ofBits_add]
  apply Finset.mem_image.mpr
  refine ⟨v, Finset.mem_univ _, ?_⟩
  simpa [matrixAddHom] using congrArg Nat.ofBits hv

/-- The quotient coloring restricted to the initial interval `[0,N)`. -/
noncomputable def intervalCosetColor {m d N : ℕ} (T : BMatrix m d) :
    Fin N → Fin (Fintype.card (BVec d ⧸ codeSubgroup T)) :=
  fun a ↦ quotientColor T (natBits d a.val)

/-- Same-colored interval points have XOR displacement in the encoded image code. -/
theorem xor_mem_codeNatFinset_of_intervalColor_eq {m d N : ℕ} (T : BMatrix m d)
    (hN : N ≤ 2 ^ d) {a b : Fin N}
    (hab : intervalCosetColor T a = intervalCosetColor T b) :
    a.val ^^^ b.val ∈ codeNatFinset T := by
  have ha : a.val < 2 ^ d := a.isLt.trans_le hN
  have hb : b.val < 2 ^ d := b.isLt.trans_le hN
  have hmem := xor_mem_codeNatFinset_of_quotientColor_eq T hab
  simpa [ofBits_natBits ha, ofBits_natBits hb] using hmem

/-- An injective `m`-dimensional code in `d` bits has exactly `2^(d-m)` additive cosets. -/
theorem card_codeQuotient {m d : ℕ} (T : BMatrix m d)
    (hT : Function.Injective (applyMatrix T)) (hmd : m ≤ d) :
    Fintype.card (BVec d ⧸ codeSubgroup T) = 2 ^ (d - m) := by
  classical
  have hcode : Nat.card (codeSubgroup T) = 2 ^ m := by
    calc
      Nat.card (codeSubgroup T) = Nat.card (BVec m) := by
        exact (Nat.card_congr (Equiv.ofInjective (matrixAddHom T) hT)).symm
      _ = 2 ^ m := by simp [Nat.card_eq_fintype_card]
  have hambient : Nat.card (BVec d) = 2 ^ d := by
    simp [Nat.card_eq_fintype_card]
  have hlagrange := (codeSubgroup T).card_eq_card_quotient_mul_card_addSubgroup
  rw [hambient, hcode] at hlagrange
  have hfactor := Nat.pow_sub_mul_pow 2 hmd
  have hcancel : Nat.card (BVec d ⧸ codeSubgroup T) * 2 ^ m =
      2 ^ (d - m) * 2 ^ m := hlagrange.symm.trans hfactor.symm
  have hcard : Nat.card (BVec d ⧸ codeSubgroup T) = 2 ^ (d - m) :=
    Nat.mul_right_cancel (pow_pos (by decide) _) hcancel
  rw [← Nat.card_eq_fintype_card]
  exact hcard

end Green25
